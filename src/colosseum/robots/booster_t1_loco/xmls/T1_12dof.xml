<mujoco model="T1">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>

  <option integrator="implicitfast"/>

  <asset>
    <material name="light_gray" rgba="0.76 0.76 0.76 1"/>
    <material name="medium_gray" rgba="0.4 0.4 0.4 1"/>

    <!-- Torso mesh -->
    <mesh name="Trunk" file="meshes/Trunk.STL"/>

    <!-- Leg meshes -->
    <mesh name="Hip_Pitch_Left" file="meshes/Hip_Pitch_Left.STL"/>
    <mesh name="Hip_Roll_Left" file="meshes/Hip_Roll_Left.STL"/>
    <mesh name="Hip_Yaw_Left" file="meshes/Hip_Yaw_Left.STL"/>
    <mesh name="Shank_Left" file="meshes/Shank_Left.STL"/>
    <mesh name="Ankle_Cross_Left" file="meshes/Ankle_Cross_Left.STL"/>
    <mesh name="left_foot_link" file="meshes/left_foot_link.STL"/>
    <mesh name="Hip_Pitch_Right" file="meshes/Hip_Pitch_Right.STL"/>
    <mesh name="Hip_Roll_Right" file="meshes/Hip_Roll_Right.STL"/>
    <mesh name="Hip_Yaw_Right" file="meshes/Hip_Yaw_Right.STL"/>
    <mesh name="Shank_Right" file="meshes/Shank_Right.STL"/>
    <mesh name="Ankle_Cross_Right" file="meshes/Ankle_Cross_Right.STL"/>
    <mesh name="right_foot_link" file="meshes/right_foot_link.STL"/>

    <!-- Visual-only meshes (not in kinematic chain) -->
    <mesh name="H1" file="meshes/H1.STL"/>
    <mesh name="H2" file="meshes/H2.STL"/>
    <mesh name="AL1" file="meshes/AL1.STL"/>
    <mesh name="AL2" file="meshes/AL2.STL"/>
    <mesh name="AL3" file="meshes/AL3.STL"/>
    <mesh name="left_hand_link" file="meshes/left_hand_link.STL"/>
    <mesh name="AR1" file="meshes/AR1.STL"/>
    <mesh name="AR2" file="meshes/AR2.STL"/>
    <mesh name="AR3" file="meshes/AR3.STL"/>
    <mesh name="right_hand_link" file="meshes/right_hand_link.STL"/>
    <mesh name="Waist" file="meshes/Waist.STL"/>
  </asset>

  <default>
    <default class="t1">
      <geom condim="1" contype="0" conaffinity="0" material="medium_gray"/>
      <site rgba="1 0 0 1" size="0.01" group="5"/>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>

      <default class="collision">
        <geom group="3"/>
        <default class="foot">
          <geom size="0.1115 0.05 0.015" pos="0.01 0 -0.015" type="box"/>
          <default class="foot_sphere">
            <geom size=".01" type="sphere"/>
          </default>
        </default>
      </default>

      <joint frictionloss="0.1"/>

      <default class="hip_pitch">
        <joint axis="0 1 0" range="-1.8 1.57" damping="0.15" armature="0.3" frictionloss="0.2"/>
      </default>
      <default class="hip_roll">
        <joint axis="1 0 0" damping="0.15" armature="0.3" frictionloss="0.2"/>
      </default>
      <default class="hip_yaw">
        <joint axis="0 0 1" range="-1 1" damping="0.15" armature="0.3" frictionloss="0.2"/>
      </default>
      <default class="knee">
        <joint axis="0 1 0" range="0 2.34" damping="0.15" armature="0.3" frictionloss="0.2"/>
      </default>
      <default class="ankle_pitch">
        <joint axis="0 1 0" range="-0.87 0.35" damping="0.15" armature="0.3" frictionloss="0.1"/>
      </default>
      <default class="ankle_roll">
        <joint axis="1 0 0" range="-0.44 0.44" damping="0.15" armature="0.3" frictionloss="0.1"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <body name="Trunk" pos="0 0 .66" childclass="t1">
      <freejoint name="floating_base_joint"/>
      <inertial pos="0.054281 8.47449e-06 0.0893932" quat="0.999999 -0.000254757 -0.00132228 -0.000215148" mass="19.4304" diaginertia="0.502019 0.3531 0.207324"/>
      <site name='imu'/>

      <!-- Visual-only geoms (head, arms, waist - not in kinematic chain) -->
      <geom class="visual" type="mesh" rgba="0.76 0.76 0.76 1.0" mesh="Trunk"/>
      <geom class="visual" pos="0.0625 0 0.243" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="H1"/>
      <geom class="visual" pos="0.0625 0 0.30485" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="H2"/>
      <geom class="visual" pos="0.0575 0.1063 0.219" quat="0.995004 0 0.0998334 0" type="mesh" rgba="0.76 0.76 0.76 1.0" mesh="AL1"/>
      <geom class="visual" pos="0.0575 0.1533 0.219" quat="0.776807 -0.621775 0.0779406 0.0623856" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="AL2"/>
      <geom class="visual" pos="0.0460173 0.16655 0.161096" quat="0.776807 -0.621775 0.0779406 0.0623856" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="AL3"/>
      <geom class="visual" pos="0.0175025 0.198766 0.0204279" quat="0.768092 -0.621729 -0.078312 -0.131739" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="left_hand_link"/>
      <geom class="visual" pos="0.0575 -0.1063 0.219" quat="0.995004 0 0.0998334 0" type="mesh" rgba="0.76 0.76 0.76 1.0" mesh="AR1"/>
      <geom class="visual" pos="0.0575 -0.1533 0.219" quat="0.776807 0.621775 0.0779406 -0.0623856" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="AR2"/>
      <geom class="visual" pos="0.0460173 -0.16655 0.161096" quat="0.776807 0.621775 0.0779406 -0.0623856" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="AR3"/>
      <geom class="visual" pos="0.0175025 -0.198766 0.0204279" quat="0.768092 0.621729 -0.078312 0.131739" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="right_hand_link"/>
      <geom class="visual" pos="0.0625 0 -0.1155" type="mesh" rgba="0.4 0.4 0.4 1.0" mesh="Waist"/>

      <!-- Left leg -->
      <body name="Hip_Pitch_Left" pos="0.0625 0.106 -0.1155">
        <inertial pos="0.000534 -0.007296 -0.018083" quat="0.975141 0.2211 0.0145808 0.0017406" mass="1.021" diaginertia="0.00180547 0.00145926 0.00125327"/>
        <joint name="Left_Hip_Pitch" class="hip_pitch"/>
        <geom class="visual" material="light_gray" mesh="Hip_Pitch_Left"/>

        <body name="Hip_Roll_Left" pos="0 0 -0.02">
          <inertial pos="0.001101 2.4e-05 -0.05375" quat="0.707081 -0.00599604 -0.00599604 0.707081" mass="0.385" diaginertia="0.001743 0.00151729 0.000514712"/>
          <joint name="Left_Hip_Roll" range="-0.3 1.57" class="hip_roll"/>
          <geom class="visual" mesh="Hip_Roll_Left"/>

          <body name="Hip_Yaw_Left" pos="0 0 -0.081854">
            <inertial pos="-0.007233 0.000206 -0.089184" quat="0.696808 -0.033953 -0.0315708 0.715758" mass="2.166" diaginertia="0.0257334 0.0253024 0.00259215"/>
            <joint name="Left_Hip_Yaw" class="hip_yaw"/>
            <geom class="visual" mesh="Hip_Yaw_Left"/>
            <geom class="collision" size="0.05 0.08" type="cylinder"/>

            <body name="Shank_Left" pos="-0.014 0 -0.134">
              <inertial pos="-0.006012 0.000259 -0.124318" quat="0.997573 0.00144024 -0.023949 0.0653706" mass="1.73" diaginertia="0.0346951 0.0345375 0.00185844"/>
              <joint name="Left_Knee_Pitch" class="knee"/>
              <geom class="visual" mesh="Shank_Left"/>
              <geom class="collision" size="0.05 0.075" pos="0 0 -0.12" type="cylinder"/>

              <body name="Ankle_Cross_Left" pos="0 0 -0.28">
                <inertial pos="-0.003722 0 -0.007981" quat="0.443136 0.551027 0.551027 0.443136" mass="0.073" diaginertia="2.9e-05 2.56589e-05 1.13411e-05"/>
                <joint name="Left_Ankle_Pitch" class="ankle_pitch"/>
                <geom class="visual" mesh="Ankle_Cross_Left"/>

                <body name="left_foot_link" pos="0 0.00025 -0.012">
                  <inertial pos="-0.000249 0 -0.00914" quat="0 0.651138 0 0.75896" mass="0.685" diaginertia="0.00269361 0.002385 0.00171539"/>
                  <joint name="Left_Ankle_Roll" class="ankle_roll"/>
                  <geom class="visual" mesh="left_foot_link"/>
                  <geom name="left_foot" class="foot"/>
                  <site name="left_foot"/>

                  <!-- Foot contact spheres (5-point contact for better stability) -->
                  <geom name="left_foot_1" class="foot_sphere" pos="-0.1 0.025 -0.02"/>
                  <geom name="left_foot_2" class="foot_sphere" pos="-0.1 -0.025 -0.02"/>
                  <geom name="left_foot_3" class="foot_sphere" pos="0.11 0.03 -0.02"/>
                  <geom name="left_foot_4" class="foot_sphere" pos="0.11 -0.03 -0.02"/>
                  <geom name="left_foot_5" class="foot_sphere" pos="0.12 0 -0.02"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Right leg -->
      <body name="Hip_Pitch_Right" pos="0.0625 -0.106 -0.1155">
        <inertial pos="0.000534 0.007514 -0.018082" quat="0.973446 -0.228403 0.0147148 -0.00419349" mass="1.021" diaginertia="0.00180552 0.0014632 0.00124928"/>
        <joint name="Right_Hip_Pitch" class="hip_pitch"/>
        <geom class="visual" material="light_gray" mesh="Hip_Pitch_Right"/>

        <body name="Hip_Roll_Right" pos="0 0 -0.02">
          <inertial pos="0.001099 2.4e-05 -0.053748" quat="0.707081 -0.00599604 -0.00599604 0.707081" mass="0.385" diaginertia="0.001743 0.00151729 0.000514712"/>
          <joint name="Right_Hip_Roll" range="-1.57 0.3" class="hip_roll"/>
          <geom class="visual" mesh="Hip_Roll_Right"/>

          <body name="Hip_Yaw_Right" pos="0 0 -0.081854">
            <inertial pos="-0.007191 -0.000149 -0.08922" quat="0.714468 -0.0315638 -0.0336391 0.698146" mass="2.17" diaginertia="0.0257623 0.0253298 0.00259389"/>
            <joint name="Right_Hip_Yaw" class="hip_yaw"/>
            <geom class="visual" mesh="Hip_Yaw_Right"/>
            <geom class="collision" size="0.05 0.08" type="cylinder"/>

            <body name="Shank_Right" pos="-0.014 0 -0.134">
              <inertial pos="-0.005741 -0.000541 -0.122602" quat="0.99926 -0.000580963 -0.023461 -0.0304754" mass="1.79" diaginertia="0.0351717 0.0349574 0.00196589"/>
              <joint name="Right_Knee_Pitch" class="knee"/>
              <geom class="visual" mesh="Shank_Right"/>
              <geom class="collision" size="0.05 0.075" pos="0 0 -0.12" type="cylinder"/>

              <body name="Ankle_Cross_Right" pos="0 0 -0.28">
                <inertial pos="-0.003722 0 -0.007981" quat="0.443136 0.551027 0.551027 0.443136" mass="0.073" diaginertia="2.9e-05 2.56589e-05 1.13411e-05"/>
                <joint name="Right_Ankle_Pitch" class="ankle_pitch"/>
                <geom class="visual" mesh="Ankle_Cross_Right"/>

                <body name="right_foot_link" pos="0 -0.00025 -0.012">
                  <inertial pos="-0.000248 0 -0.00914" quat="0 0.651138 0 0.75896" mass="0.685" diaginertia="0.00269361 0.002385 0.00171539"/>
                  <joint name="Right_Ankle_Roll" class="ankle_roll"/>
                  <geom class="visual" mesh="right_foot_link"/>
                  <geom name="right_foot" class="foot"/>
                  <site name="right_foot"/>

                  <!-- Foot contact spheres (5-point contact for better stability) -->
                  <geom name="right_foot_1" class="foot_sphere" pos="-0.1 0.025 -0.02"/>
                  <geom name="right_foot_2" class="foot_sphere" pos="-0.1 -0.025 -0.02"/>
                  <geom name="right_foot_3" class="foot_sphere" pos="0.11 0.03 -0.02"/>
                  <geom name="right_foot_4" class="foot_sphere" pos="0.11 -0.03 -0.02"/>
                  <geom name="right_foot_5" class="foot_sphere" pos="0.12 0 -0.02"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <gyro name="imu_ang_vel" site="imu"/>
    <velocimeter name="imu_lin_vel" site="imu"/>
    <accelerometer name="imu_lin_acc" site="imu"/>
    <framequat name="orientation" objtype="site" objname="imu"/>
    <subtreeangmom name="root_angmom" body="Trunk"/>
  </sensor>

</mujoco>
